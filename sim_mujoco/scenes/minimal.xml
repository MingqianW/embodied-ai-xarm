<mujoco model="minimal_test">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <worldbody>
    <light
      name="main_light"
      pos="0 0 3"
      dir="0 0 -1"
      diffuse="0.8 0.8 0.8"/>

    <camera
      name="test_camera"
      pos="1.5 -1.5 1.2"
      xyaxes="0.707 0.707 0 -0.36 0.36 0.86"
      fovy="50"/>

    <geom
      name="floor"
      type="plane"
      size="2 2 0.1"
      rgba="0.75 0.75 0.75 1"
      friction="1 0.01 0.001"/>

    <body name="falling_box" pos="0 0 1">
      <freejoint/>
      <geom
        name="box_geom"
        type="box"
        size="0.1 0.1 0.1"
        mass="1"
        rgba="0.8 0.2 0.2 1"/>
    </body>
  </worldbody>
</mujoco>